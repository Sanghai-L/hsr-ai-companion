{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "field_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "quantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "flat",
            "ratio",
            "percent",
            "percentage_point",
            "speed",
            "av",
            "toughness",
            "count"
          ]
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_owned"
          ]
        },
        "precision": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "unit",
        "state",
        "precision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "manual",
            "uid_public",
            "derived",
            "synthetic",
            "maintainer",
            "web"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "license": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "ref",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "confirmed": {
      "type": "boolean"
    },
    "basis": {
      "enum": [
        "base",
        "equipment_bonus",
        "public_panel",
        "record"
      ]
    }
  },
  "required": [
    "entity_id",
    "field_id",
    "quantity",
    "source",
    "confirmed",
    "basis"
  ],
  "additionalProperties": false
}
