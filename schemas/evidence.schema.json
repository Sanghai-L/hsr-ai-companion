{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "observed_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "verification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "content_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000
    },
    "stance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "trust": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "applicable_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "depends_on": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string"
      }
    },
    "root_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "account_id",
    "claim",
    "url",
    "observed_at",
    "kind",
    "verification",
    "content_sha256",
    "content",
    "stance",
    "trust",
    "applicable_version",
    "source_ref",
    "depends_on",
    "root_sources"
  ]
}
