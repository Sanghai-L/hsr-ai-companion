{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "mode": {
      "enum": [
        "moc",
        "pure_fiction",
        "apocalyptic_shadow",
        "anomaly_arbitration"
      ]
    },
    "versions": {
      "type": "object",
      "properties": {
        "game": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "period": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "knowledge": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "data_commit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "engine": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "rules": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "wave": {
            "type": "integer",
            "minimum": 1
          },
          "enemies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            }
          }
        },
        "required": [
          "wave",
          "enemies"
        ],
        "additionalProperties": false
      }
    },
    "information_state": {
      "enum": [
        "official_verified",
        "official_disputed",
        "beta",
        "leak",
        "stale",
        "unknown"
      ]
    },
    "evidence": {
      "enum": [
        "primary",
        "reproduced",
        "community",
        "hypothesis",
        "unknown"
      ]
    },
    "coverage": {
      "enum": [
        "verified",
        "approximate",
        "unsupported",
        "unknown"
      ]
    },
    "initial_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "field_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "quantity": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "enum": [
                  "flat",
                  "ratio",
                  "percent",
                  "percentage_point",
                  "speed",
                  "av",
                  "toughness",
                  "count"
                ]
              },
              "state": {
                "enum": [
                  "known",
                  "unknown",
                  "not_owned"
                ]
              },
              "precision": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "value",
              "unit",
              "state",
              "precision"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "known"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "value": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "manual",
                  "uid_public",
                  "derived",
                  "synthetic",
                  "maintainer",
                  "web"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "license": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "ref",
              "observed_at"
            ],
            "additionalProperties": false
          },
          "confirmed": {
            "type": "boolean"
          },
          "basis": {
            "enum": [
              "base",
              "equipment_bonus",
              "public_panel",
              "record"
            ]
          }
        },
        "required": [
          "entity_id",
          "field_id",
          "quantity",
          "source",
          "confirmed",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "maxItems": 200
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "manual",
              "uid_public",
              "derived",
              "synthetic",
              "maintainer",
              "web"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "license": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "type",
          "ref",
          "observed_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "scenario_id",
    "mode",
    "versions",
    "valid_from",
    "valid_to",
    "observed_at",
    "waves",
    "information_state",
    "evidence",
    "coverage",
    "initial_resources",
    "missing_fields",
    "sources"
  ],
  "additionalProperties": false
}
