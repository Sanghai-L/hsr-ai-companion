{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "version", "target", "channel", "files", "payload_sha256", "payload_size", "inputs"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["program", "knowledge"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "target": {"enum": ["windows-x64", "data"]},
    "channel": {"enum": ["test", "production"]},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_size": {"type": "integer", "minimum": 1, "maximum": 100663296},
    "inputs": {"type": "object"},
    "files": {"type": "array", "minItems": 1, "maxItems": 6000, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "size", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 240},
        "size": {"type": "integer", "minimum": 0, "maximum": 268435456},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }}
  }
}
